theme = Catppuccin Mocha

# Window settings
window-decoration = false
window-inherit-working-directory = true
window-theme = dark
window-save-state = always
window-width = 120
window-height = 45
confirm-close-surface = false
window-colorspace = srgb
fullscreen = true

# Mouse settings
mouse-hide-while-typing = true
copy-on-select = true

# Background and transparency settings
background-opacity = 0.7
background-blur = 1
unfocused-split-opacity = 0.65

# Font and cursor settings
font-family = FiraCode Nerd Font Mono
font-size = 13
cursor-style = bar
cursor-style-blink = false

# misc
shell-integration = zsh
shell-integration-features = cursor


# Ghostty Custom Keybindings Config

## Split Management

# Close Current Split (Surface)
keybind = ctrl+w=close_surface

# Toggle transparency (apparently macos only)
#keybind = alt+shift+t=toggle_background_opacity


# New Splits (Vim-style directional)
keybind = alt+shift+h=new_split:left
keybind = alt+shift+j=new_split:down
keybind = alt+shift+k=new_split:up
keybind = alt+shift+l=new_split:right

# Navigate Between Splits (Vim-style directional)
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right

# Resize Splits (Vim-style directional with Super+Ctrl+Shift)
keybind = super+shift+h=resize_split:left,10
keybind = super+shift+j=resize_split:down,10
keybind = super+shift+k=resize_split:up,10
keybind = super+shift+l=resize_split:right,10


## Clipboard & Selection

keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = shift+insert=paste_from_selection
keybind = ctrl+shift+a=select_all

# Adjust Selection (Arrow style)
keybind = shift+up=adjust_selection:up
keybind = shift+down=adjust_selection:down
keybind = shift+left=adjust_selection:left
keybind = shift+right=adjust_selection:right


## Configuration & Window Management

keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+,=open_config
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+n=new_window


## Scrolling

keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down
